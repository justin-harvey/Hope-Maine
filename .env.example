# Signs the login cookies for /admin. Generate a fresh one per environment:
#   openssl rand -hex 32
# Changing it logs every editor out, which is what you want if it ever leaks.
PAYLOAD_SECRET=

# Local development defaults to a SQLite file and needs nothing set here.
#
# Deployed environments MUST point this at Postgres. Netlify and Vercel
# rebuild the filesystem on every deploy, so a SQLite file on those hosts
# would quietly throw away everything the town had written.
#   DATABASE_URI=postgresql://user:password@host/dbname
DATABASE_URI=

# The site's own origin, used to build absolute URLs for uploaded files.
# On Netlify set this to the site's real URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── File storage ─────────────────────────────────────────────
#
# Without these, uploads write to public/uploads — the same filesystem the
# host rebuilds on every deploy, so every uploaded PDF is lost on the next
# push. Fine locally; never on a deployed site.
#
# From Supabase: Project Settings -> Storage -> S3 connection. Create the
# bucket first under Storage.
#   S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
#   S3_REGION=<your project's region, e.g. us-east-1>
#   S3_BUCKET=hope-uploads
#   S3_ACCESS_KEY_ID=...
#   S3_SECRET_ACCESS_KEY=...
#
# The same four work for Cloudflare R2, Backblaze B2, or AWS S3 — only the
# endpoint changes.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
