# Signs the login cookies for /admin. Generate a fresh one per environment:
#   openssl rand -hex 32
# Changing it logs every editor out, which is what you want if it ever leaks.
PAYLOAD_SECRET=

# Local development defaults to a SQLite file and needs nothing set here.
#
# Deployed environments MUST point this at Postgres. Netlify and Vercel
# rebuild the filesystem on every deploy, so a SQLite file on those hosts
# would quietly throw away everything the town had written.
#   DATABASE_URI=postgresql://user:password@host/dbname
DATABASE_URI=

# The site's own origin, used to build absolute URLs for uploaded files.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
